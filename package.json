{
  "name": "witnesscrumbs",
  "version": "0.1.2",
  "description": "Breadcrumbs collector with session video, LLM-ready prompts and an HTML report — drop-in QA witness for the browser.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build:js": "vite build --config vite.lib.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "yarn build:js && yarn build:types",
    "preview": "vite preview",
    "test": "node --import tsx --test src/core/llm/__tests__/*.test.ts",
    "prepublishOnly": "yarn test && yarn build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  },
  "keywords": [
    "breadcrumbs",
    "qa",
    "debugging",
    "session-replay",
    "logging",
    "llm",
    "react",
    "frontend",
    "observability"
  ],
  "author": "Ilya Gorsky <gorsky.art@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaGorsky/witnesscrumbs.git"
  },
  "bugs": {
    "url": "https://github.com/IlyaGorsky/witnesscrumbs/issues"
  },
  "homepage": "https://github.com/IlyaGorsky/witnesscrumbs#readme",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
